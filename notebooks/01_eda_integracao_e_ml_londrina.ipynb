    "print(f'Ocorrências com Chuva/Garoa na PRF (2022-2024): {len(chuva_prf)} de {len(prf_22_24)} ({len(chuva_prf)/len(prf_22_24)*100:.1f}%)')\n",
    "print(f'Concordância com chuva > 0 mm em Londrina:  {(chuva_prf[\"precip_londrina_mm\"] > 0).mean()*100:.1f}%')\n",
    "print(f'Concordância com chuva >= 1 mm em Londrina: {(chuva_prf[\"precip_londrina_mm\"] >= 1.0).mean()*100:.1f}%')\n",
    "print(f'Concordância com chuva >= 1 mm em A835:     {(chuva_prf[\"a835_precip_mm\"].dropna() >= 1.0).mean()*100:.1f}%')"
   ]
