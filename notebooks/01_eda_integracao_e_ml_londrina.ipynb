   "id": "cell-06",
   "metadata": {},
   "outputs": [],
   "source": [
    "null_report = pd.DataFrame({\n",
    "    'Nulos (2022-2024)': daily_22_24.isna().sum(),\n",
    "    '% Nulos (2022-2024)': (daily_22_24.isna().mean() * 100).round(2),\n",
    "    'Nulos (2022-2025)': daily_full.isna().sum(),\n",
    "    '% Nulos (2022-2025)': (daily_full.isna().mean() * 100).round(2),\n",
